{
  "name": "dsh-plugin-practical-tool-bundle",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "description": "七个可以单独开关的小工具：一键清理会话、推理报错自动重试、加载项目 Claude 技能、重启按钮、手机大按钮、官方功能开关，以及基于飞书的任务和调度会话。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FanetheDivine/dsh-plugin-practical-tool-bundle.git"
  },
  "homepage": "https://github.com/FanetheDivine/dsh-plugin-practical-tool-bundle#readme",
  "bugs": {
    "url": "https://github.com/FanetheDivine/dsh-plugin-practical-tool-bundle/issues"
  },
  "author": "Fane",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "plugin",
    "session-sweeper",
    "restart",
    "claude-skills",
    "mobile",
    "official-features",
    "lark-super-agent",
    "dispatch"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./sweeper": {
      "types": "./dist/sweeper.d.ts",
      "import": "./dist/sweeper.mjs"
    },
    "./sweeper/locale/*.json": "./rows/sweeper/locale/*.json",
    "./sweeper/icon": "./rows/sweeper/icon.svg",
    "./reasoning-reset": {
      "types": "./dist/reasoning-reset.d.ts",
      "import": "./dist/reasoning-reset.mjs"
    },
    "./reasoning-reset/locale/*.json": "./rows/reasoning-reset/locale/*.json",
    "./reasoning-reset/icon": "./rows/reasoning-reset/icon.svg",
    "./claude-skills": {
      "types": "./dist/claude-skills.d.ts",
      "import": "./dist/claude-skills.mjs"
    },
    "./claude-skills/locale/*.json": "./rows/claude-skills/locale/*.json",
    "./claude-skills/icon": "./rows/claude-skills/icon.svg",
    "./restart": {
      "types": "./dist/restart.d.ts",
      "import": "./dist/restart.mjs"
    },
    "./restart/locale/*.json": "./rows/restart/locale/*.json",
    "./restart/icon": "./rows/restart/icon.svg",
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.mjs"
    },
    "./mobile/locale/*.json": "./rows/mobile/locale/*.json",
    "./mobile/icon": "./rows/mobile/icon.svg",
    "./official-features": {
      "types": "./dist/official-features.d.ts",
      "import": "./dist/official-features.mjs"
    },
    "./official-features/locale/*.json": "./rows/official-features/locale/*.json",
    "./official-features/icon": "./rows/official-features/icon.svg",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./lark-super-agent": {
      "types": "./dist/lark-super-agent.d.ts",
      "import": "./dist/lark-super-agent.mjs"
    },
    "./lark-super-agent/locale/*.json": "./rows/lark-super-agent/locale/*.json",
    "./lark-super-agent/icon": "./rows/lark-super-agent/icon.svg",
    "./sa-dispatch": {
      "types": "./dist/sa-dispatch.d.ts",
      "import": "./dist/sa-dispatch.mjs"
    },
    "./sa-dispatch/locale/*.json": "./rows/sa-dispatch/locale/*.json",
    "./sa-dispatch/icon": "./rows/sa-dispatch/icon.svg",
    "./sa-worker": {
      "types": "./dist/sa-worker.d.ts",
      "import": "./dist/sa-worker.mjs"
    },
    "./sa-worker/locale/*.json": "./rows/sa-worker/locale/*.json",
    "./sa-worker/icon": "./rows/sa-worker/icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "rows",
    "assets/*",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && tsc -p tsconfig.build.json && pnpm run test:dist --reporter=minimal --silent=passed-only",
    "check": "pnpm run typecheck && pnpm run lint --diagnostic-level=error && pnpm run test:code --reporter=minimal --silent=passed-only",
    "full-check": "pnpm run check && pnpm run build",
    "release": "pnpm check && pnpm format && npm version patch && node scripts/release-archive.mjs && git push && git push --tags",
    "typecheck": "tsc --noEmit",
    "test:code": "vitest run --project code",
    "test:dist": "vitest run --project dist",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "dsh-plugin-meta-tools": "0.1.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "zod": "4.6.6"
  }
}
